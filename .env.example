# Copy to .env for local overrides. None of these are required to start the app.

APP_NAME=self-healing-devops-platform
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Local default; container default is sqlite+pysqlite:////data/app.sqlite
DATABASE_URL=sqlite+pysqlite:///./data/app.sqlite

DEMO_FAILURE_ENABLED=false
DEMO_AUTH_TOKEN=
DEMO_MAX_DURATION_SECONDS=60
DEMO_MAX_FAILING_REQUESTS=100

REMEDIATION_ENABLED=false
REMEDIATION_DRY_RUN_ONLY=true
REMEDIATION_AUTH_TOKEN=
KUBERNETES_REMEDIATION_ENABLED=false

AI_SUMMARIES_ENABLED=false
AI_API_URL=
AI_API_TOKEN=
AI_TIMEOUT_SECONDS=8

MAX_REQUEST_BYTES=65536

# Used by Compose interpolation only. Not a production secret.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-demo-change-me
